# DocuFlow ML Sidecar Environment Variables
# Copy to .env and customize

# Server
DOCUFLOW_ML_HOST=0.0.0.0
DOCUFLOW_ML_PORT=50051
DOCUFLOW_ML_GRPC_MAX_MESSAGE_SIZE=52428800
DOCUFLOW_ML_GRPC_MAX_WORKERS=4

# Model Configuration
DOCUFLOW_ML_MODEL_CACHE_DIR=/models
DOCUFLOW_ML_DEVICE=auto
DOCUFLOW_ML_TORCH_DTYPE=auto

# Model Names (HuggingFace model IDs)
DOCUFLOW_ML_LAYOUTLM_CLASSIFIER_MODEL=microsoft/layoutlmv3-base
DOCUFLOW_ML_LAYOUTLM_EXTRACTION_MODEL=microsoft/layoutlmv3-base
DOCUFLOW_ML_DONUT_MODEL=naver-clova-ix/donut-base-finetuned-cord-v2
DOCUFLOW_ML_TABLE_DETECTION_MODEL=microsoft/table-transformer-detection
DOCUFLOW_ML_TABLE_STRUCTURE_MODEL=microsoft/table-transformer-structure
DOCUFLOW_ML_ELEMENT_DETECTION_MODEL=microsoft/layoutlmv3-base

# Inference Settings
DOCUFLOW_ML_MAX_BATCH_SIZE=4
DOCUFLOW_ML_MAX_SEQUENCE_LENGTH=512
DOCUFLOW_ML_CONFIDENCE_THRESHOLD=0.5
DOCUFLOW_ML_NMS_THRESHOLD=0.3

# Image Processing
DOCUFLOW_ML_MAX_IMAGE_SIZE=4096
DOCUFLOW_ML_TARGET_DPI=300

# Logging
DOCUFLOW_ML_LOG_LEVEL=INFO
DOCUFLOW_ML_LOG_FORMAT=json

# Metrics
DOCUFLOW_ML_METRICS_ENABLED=true
DOCUFLOW_ML_METRICS_PORT=9090

# Health Check
DOCUFLOW_ML_HEALTH_CHECK_INTERVAL=30